# BCS Beam desktop client — points at Brocent's self-hosted OpenIM + the
# customer portal's own login page (see NOTICE.md "Login architecture
# finding" for why login goes through the portal page, not a native form).
# Same reverse-proxy paths already proven working by support-chat-web
# (infra/nginx/reverse-proxy.conf, customer.centoffer.com server block).

VITE_API_URL=https://customer.centoffer.com/openim-api
VITE_WS_URL=wss://customer.centoffer.com/openim-ws
VITE_PORTAL_LOGIN_URL=https://customer.centoffer.com/customer-portal/login
# Read by the renderer (src/pages/tickets), not the main process — Vite
# exposes VITE_-prefixed .env vars to import.meta.env automatically.
VITE_PORTAL_TICKETS_URL=https://customer.centoffer.com/customer-portal/tickets

# Unused as of the Phase 1 login rewrite (OpenIM's own demo "chat" business
# backend, which BCS Beam never runs) — left unset rather than deleted from
# src/api/login.ts, which still imports it harmlessly (dead code, not called
# from anywhere after this rewrite). Do not point this at a real server.
# VITE_CHAT_URL=
