strict-peer-dependencies=true
save-exact=true
ELECTRON_MIRROR="https://npmmirror.com/mirrors/electron/"
ELECTRON_BUILDER_BINARIES_MIRROR="https://npmmirror.com/mirrors/electron-builder-binaries/"
# pnpm's default node-linker ("isolated") puts every package under
# node_modules/.pnpm/<name>@<version>/node_modules/<name>, symlinked into
# place — great for disk space and dependency hygiene, but electron-builder's
# asar packer doesn't reliably walk that symlink structure for *transitive*
# deps (a dependency of a dependency). Found this the hard way on 2026-08-28
# doing the first-ever Windows packaging run of this repo: koffi (needed by
# @openim/electron-client-sdk's native IM SDK core) silently never made it
# into the packaged app, and separately @babel/runtime (needed by i18next)
# crashed the packaged app on startup with "Cannot find module
# '@babel/runtime/helpers/typeof'" — two different transitive deps hitting
# the identical root cause. Rather than keep discovering and hoisting one
# missing package at a time (public-hoist-pattern, tried first for koffi
# alone — see git history), switch to pnpm's flat/hoisted layout, which is
# the standard documented fix for pnpm + electron-builder specifically: every
# package, transitive or not, gets a real top-level node_modules/<name> entry,
# same as npm/yarn would produce, so electron-builder's packaging sees
# everything it needs to.
node-linker=hoisted
